{
  "name": "goldfinch",
  "version": "0.12.0",
  "description": "A Chromium-based browser with an expandable media panel for viewing, playing, and downloading site media.",
  "main": "src/main/main.js",
  "author": "msieurthenardier <msieurthenardier@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prestart": "npm run build:preload",
    "start": "electron .",
    "dev": "node scripts/dev-launch.mjs --enable-logging",
    "dev:automation": "node scripts/dev-launch.mjs --enable-logging --no-sandbox --automation-dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:preload": "node scripts/build-preload.mjs",
    "pretest": "npm run build:preload",
    "test": "node --test test/unit/*.test.js",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "a11y": "node scripts/a11y-audit.mjs",
    "version": "node scripts/update-readme.mjs && git add README.md"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.goldfinch.browser",
    "productName": "Goldfinch",
    "asar": false,
    "publish": {
      "provider": "github",
      "owner": "msieurthenardier",
      "repo": "goldfinch"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "beforePack": "scripts/build-preload-hook.cjs",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "msieurthenardier <msieurthenardier@gmail.com>"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "axe-core": "^4.12.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
