{
  "name": "goldfinch",
  "version": "0.19.18",
  "description": "A Chromium-based browser with an expandable media panel for viewing, playing, and downloading site media.",
  "main": "src/main/main.js",
  "desktopName": "goldfinch.desktop",
  "author": "msieurthenardier <msieurthenardier@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prestart": "npm run build:preload",
    "start": "electron .",
    "dev": "node scripts/dev-launch.mjs --enable-logging",
    "dev:automation": "node scripts/dev-launch.mjs --enable-logging --no-sandbox --automation-dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:preload": "node scripts/build-preload.mjs",
    "pretest": "npm run build:preload",
    "test": "node --test test/unit/*.test.js",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y": "node scripts/a11y-audit.mjs",
    "preversion": "node scripts/check-psl-fresh.mjs",
    "version": "node scripts/update-readme.mjs && git add README.md"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.goldfinch.browser",
    "productName": "Goldfinch",
    "asar": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "resetAdHocDarwinSignature": true
    },
    "publish": {
      "provider": "github",
      "owner": "msieurthenardier",
      "repo": "goldfinch"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "beforePack": "scripts/build-preload-hook.cjs",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "syncDesktopName": true,
      "maintainer": "msieurthenardier <msieurthenardier@gmail.com>"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch@^9.0.3": "^11.0.1",
    "minimatch@^10.2.4": "^11.0.1",
    "minimatch@^10.2.5": "^11.0.1",
    "minimatch@^10.2.6": "^11.0.1"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
