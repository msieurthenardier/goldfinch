# Goldfinch dev environment variables. Copy this file to `.env` (gitignored — never commit
# real values) and fill in what you need. All are optional; the app runs fine with none set.
# See docs/dev-testing.md for the full explanation of each one.

# Gate: set to 1 to mint an admin automation key when launching `npm run dev:automation`.
GOLDFINCH_AUTOMATION_ADMIN=replace-me

# Per-jar automation Bearer key minted by a dev launch (see docs/dev-testing.md "Key
# capture") — never a real secret in this example file.
GOLDFINCH_MCP_KEY=replace-me

# Dev-only override for the loopback MCP automation server's port (default 49707).
# Honored only on an unpackaged build; ignored on a packaged binary.
GOLDFINCH_MCP_PORT=replace-me

# Dev-only full-URL override for the MCP automation endpoint (escape hatch beyond port).
GOLDFINCH_MCP_URL=replace-me

# Opt-in vault capture-lifecycle debug trace; set to 1 to log step names to the console.
# Never logs secrets (see docs/dev-testing.md "Debug flags").
GOLDFINCH_VAULT_TRACE=replace-me
